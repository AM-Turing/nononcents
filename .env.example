# NoNonCents settings. Copy to .env (./start.sh does this for you and fills in the secrets).
# Never commit .env. Values with a "#" in them must be quoted.

# --- Required -------------------------------------------------------------------------------
# Django secret key: at least 50 random characters, unique to this installation.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
# Password for the PostgreSQL database user below: a long random string.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Database -------------------------------------------------------------------------------
POSTGRES_DB=nononcents
POSTGRES_USER=nononcents
# Host name of the database container; leave as "db" with the bundled compose.yml.
POSTGRES_HOST=db

# --- Network --------------------------------------------------------------------------------
# Where the app listens on this computer, as ADDRESS:PORT. 127.0.0.1 means only this computer.
# Use 0.0.0.0:8000 to reach it from other devices on your network (prefer an HTTPS proxy).
WEB_BIND=127.0.0.1:8000
# Comma-separated host names the app answers to.
ALLOWED_HOSTS=127.0.0.1,localhost
# Full origins (with https://) you browse from when using a reverse proxy, comma-separated.
# Leave empty for plain http://127.0.0.1 or http://localhost use.
CSRF_TRUSTED_ORIGINS=
# Time zone for dates and times (an IANA name such as Europe/London or America/Chicago).
TIME_ZONE=UTC
# Debug mode shows detailed errors. Keep false anywhere real data is stored.
DJANGO_DEBUG=false
# Seconds a sign-in lasts (28800 = 8 hours).
SESSION_COOKIE_AGE=28800

# --- HTTPS behind a reverse proxy -----------------------------------------------------------
# Set all of these together once a proxy serves the app over HTTPS and sends
# X-Forwarded-Proto and X-Real-IP. Leave them as they are for plain http on this computer.
SECURE_SSL_REDIRECT=false
TRUST_PROXY_HTTPS=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# 0 at first; 31536000 (one year) once HTTPS works on every device.
SECURE_HSTS_SECONDS=0
# Networks the proxy reaches the app from. Only these may name the visitor in X-Real-IP
# (used by sign-in throttling and the activity log). The default covers a proxy on this
# computer and Docker's private bridge networks.
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128,172.16.0.0/12

# --- Backups (scripts/backup.sh, scripts/restore.sh) -----------------------------------------
# Folder for database dumps, relative to this folder or absolute. Created with owner-only access.
BACKUP_DIR=./backups
# Days to keep old dumps, and the number of newest dumps that are always kept.
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=7
# Optional: space-separated extra folders that receive a verified copy of every dump (for
# example a mounted external disk). Each must already exist; it is never created for you.
BACKUP_COPY_DIRS=
# Optional: a URL requested after every successful backup (a dead-man's-switch monitor).
BACKUP_PING_URL=
# Where the secret-free status file lives (shown to administrators in the app) and where the
# optional "Back up now" button leaves its requests. Default to folders inside BACKUP_DIR.
# BACKUP_STATUS_DIR=./backups/status
# BACKUP_REQUEST_DIR=./backups/requests
# Hours without a successful backup before the app warns administrators.
BACKUP_MAX_AGE_HOURS=26

# --- AI analysis (optional, off by default) ---------------------------------------------------
# The Outlook page can ask an AI model for a written summary. Leave the provider "disabled" to
# send nothing anywhere. WARNING: when enabled, a summary of your financial totals is sent to
# the URL below, so only use a server you trust (for example a local Ollama or llama.cpp).
# REPORT_LLM_PROVIDER: disabled | openai_compatible (any OpenAI-compatible chat completions
# endpoint, local or hosted).
REPORT_LLM_PROVIDER=disabled
# Example: http://host.docker.internal:11434/v1/chat/completions
REPORT_LLM_URL=
REPORT_LLM_MODEL=
# Optional bearer token, only for endpoints that require one.
REPORT_LLM_API_KEY=
REPORT_LLM_TIMEOUT_SECONDS=120
# Ask a reasoning model not to "think" first (faster, shorter); needs server support.
REPORT_LLM_DISABLE_THINKING=false
REPORT_LLM_MAX_TOKENS=2200

# --- Logging ----------------------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR. Financial form data is never logged.
DJANGO_LOG_LEVEL=WARNING
